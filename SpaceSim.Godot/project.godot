; SpaceSim 1.4 â€” presentation and input only; authoritative state lives in Core.
config_version=5

[application]
config/name="SpaceSim | Lance test range"
config/version="2.4.0"
run/main_scene="res://Scenes/Flight.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"

[dotnet]
project/assembly_name="SpaceSim.Godot"

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.0196, 0.0314, 0.0549, 1)
